# --- Database (Neon) ---
# Pooled connection string (host contains "-pooler") used by the running API.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# Direct (non-pooled) string, used only by `prisma migrate deploy`.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=require

# --- Security ---
JWT_SECRET=            # >= 32 random chars:  openssl rand -base64 48
IP_HASH_SALT=          # random string; required in production
SESSION_DAYS=7
CORS_ORIGINS=https://masfig.com,https://www.masfig.com,https://masfig.pages.dev

# --- Site ---
PUBLIC_SITE_URL=https://masfig.com
CF_PAGES_DEPLOY_HOOK_URL=   # Cloudflare Pages > Settings > Builds > Deploy hooks

# --- Media (Cloudflare R2, S3-compatible) ---
STORAGE_DRIVER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://media.masfig.com   # public bucket domain, no trailing slash

# --- Optional: email notification for new enquiries (Resend) ---
RESEND_API_KEY=
ENQUIRY_NOTIFY_EMAIL=
MAIL_FROM="MASFIG <no-reply@masfig.com>"
